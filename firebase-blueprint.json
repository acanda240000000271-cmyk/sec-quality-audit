{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Employee profile without email PII.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "department": { "type": "string", "minLength": 1, "maxLength": 100 },
        "roleCategory": { "type": "string", "enum": ["Teacher", "Librarian", "School Leader", "Office", "Support Staff"] },
        "position": { "type": "string", "minLength": 1, "maxLength": 100 },
        "yearsInRole": { "type": "integer" },
        "jobDescription": { "type": "string", "minLength": 1, "maxLength": 500 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "photoURL", "department", "roleCategory", "position", "yearsInRole", "jobDescription", "updatedAt"]
    },
    "CircleSession": {
      "title": "CircleSession",
      "description": "Quality Circle check-in session and saved Affinity Board.",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "status": { "type": "string", "enum": ["open", "completed"] },
        "answerCount": { "type": "integer" },
        "rebuildCount": { "type": "integer" },
        "profileSnapshot": { "type": "object" },
        "board": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sessionId", "userId", "status", "answerCount", "rebuildCount", "profileSnapshot", "board", "createdAt", "completedAt"]
    },
    "InteractionMessage": {
      "title": "InteractionMessage",
      "description": "Immutable chat message in a Quality Circle check-in session.",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "clientMessageId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "role": { "type": "string", "enum": ["user", "assistant"] },
        "content": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "topicNumber": { "type": "integer" },
        "timestamp": { "type": "string", "format": "date-time" },
        "modelUsed": { "type": "string", "maxLength": 100 }
      },
      "required": ["sessionId", "userId", "clientMessageId", "role", "content", "topicNumber", "timestamp", "modelUsed"]
    },
    "CompanyBasis": {
      "title": "CompanyBasis",
      "description": "Single settings document holding SEC quality baseline documents.",
      "type": "object",
      "properties": {
        "documents": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["documents", "updatedAt"]
    },
    "WallReport": {
      "title": "WallReport",
      "description": "Saved school-wide Circle Wall report generated by admin.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "markdown": { "type": "string", "minLength": 1, "maxLength": 200000 },
        "stats": { "type": "object" },
        "modelUsed": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "required": ["id", "title", "markdown", "stats", "modelUsed", "createdAt", "createdBy"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Manually provisioned superadmin marker document.",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["superadmin"] }
      },
      "required": ["role"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Employee profile documents isolated per user."
    },
    "/users/{userId}/circleSessions/{sessionId}": {
      "schema": { "$ref": "#/entities/CircleSession" },
      "description": "Quality Circle check-in sessions and Affinity Boards."
    },
    "/users/{userId}/interactions/{interactionId}": {
      "schema": { "$ref": "#/entities/InteractionMessage" },
      "description": "Immutable check-in chat messages."
    },
    "/settings/companyBasis": {
      "schema": { "$ref": "#/entities/CompanyBasis" },
      "description": "SEC quality baseline documents."
    },
    "/wallReports/{reportId}": {
      "schema": { "$ref": "#/entities/WallReport" },
      "description": "Saved school-wide quality reports."
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Superadmin membership document (read own only, never written by app)."
    }
  }
}
